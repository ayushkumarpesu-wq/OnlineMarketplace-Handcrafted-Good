MONGO_URI=mongodb://localhost:27017/handcrafted_goods
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000

# Use Razorpay Test Mode credentials while developing.
# Keep the key secret on the backend; never add it to frontend environment variables.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_test_key_secret

# Optional email configuration for OTP login.
SMTP_USER=
SMTP_PASS=